<Application x:Class="ChappyStorageCompressor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Panel" Color="#182434"/>
        <SolidColorBrush x:Key="PanelTwo" Color="#223246"/>
        <SolidColorBrush x:Key="Accent" Color="#57D1BC"/>
        <SolidColorBrush x:Key="Fg" Color="#F1F6FC"/>
        <SolidColorBrush x:Key="Muted" Color="#ABC1D4"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4FCFF"/>
            <Setter Property="Background" Value="#30465C"/>
            <Setter Property="BorderBrush" Value="#405A70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Application.Resources>
</Application>
