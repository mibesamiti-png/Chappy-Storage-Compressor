<Window x:Class="ChappyStorageCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chappy Storage Compressor R2.2 — 容量回復の事前安全診断" Width="1140" Height="830"
        MinWidth="900" MinHeight="660" Background="#0E1724" FontFamily="Yu Gothic UI, Segoe UI"
        Foreground="#F1F6FC" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="150"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="True">
      <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#173E3D" CornerRadius="14" Padding="10,5" Margin="10,0,0,0">
        <TextBlock Foreground="#79E1C8" Text="R2.1  ·  重複と圧縮の重なり分析" FontSize="12"/>
      </Border>
      <StackPanel>
        <TextBlock Text="CHAPPY  /  STORAGE LAB" Foreground="#57D1BC" FontSize="12" FontWeight="Bold"/>
        <TextBlock Text="完全一致ファイルの重複検出・統合" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,5"/>
        <TextBlock Text="重複は読み取り専用検出。PNGは元の場所を保持し、候補を別フォルダに順次生成。" Foreground="#ABC1D4" FontSize="13"/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="対象の親フォルダ" FontSize="12" Foreground="#ABC1D4" Margin="0,0,0,7"/>
        <DockPanel LastChildFill="True">
          <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="フォルダを選択" Click="Browse_Click"/>
          <TextBox x:Name="PathBox" Background="#0E1724" Foreground="#F1F6FC" BorderBrush="#486276" FontSize="15" VerticalContentAlignment="Center" Height="40" Padding="10,0" TextChanged="PathChanged" ToolTip="C:\Pictures などの親フォルダ"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <CheckBox x:Name="MediaOnlyCheck" Content="JPG / JPEG / PNG / MP4のみ（推奨）" IsChecked="True" VerticalAlignment="Center" Margin="0,0,22,0" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
          <CheckBox x:Name="TimeDifferenceCheck" Content="作成日時・更新日時の差を許容（要注意）" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="調査したファイル" Foreground="#ABC1D4" FontSize="12"/><TextBlock x:Name="ScannedCountText" Text="—" FontWeight="SemiBold" FontSize="22"/></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="完全一致グループ" Foreground="#ABC1D4" FontSize="12"/><TextBlock x:Name="GroupCountText" Text="—" FontWeight="SemiBold" FontSize="22"/></StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="統合可能グループ" Foreground="#ABC1D4" FontSize="12"/><TextBlock x:Name="SafeCountText" Text="—" FontWeight="SemiBold" FontSize="22"/></StackPanel>
      </Border>
      <Border Grid.Column="3" Background="#173E3D" CornerRadius="12" Padding="14">
        <StackPanel><TextBlock Text="推定回復量（論理値）" Foreground="#ACD9D2" FontSize="12"/><TextBlock x:Name="SavingsText" Text="—" Foreground="#79E1C8" FontWeight="SemiBold" FontSize="22"/></StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,0,0,12">
      <WrapPanel Margin="0,0,0,10">
        <Button x:Name="ScanButton" Content="① 読み取り専用スキャン" Background="#2B7B70" BorderBrush="#3E9E8F" Click="Scan_Click"/>
        <Button x:Name="DetailsButton" Content="選択グループの全パス" Click="Details_Click" IsEnabled="False"/>
        <Button x:Name="MergeButton" Content="② 統合（実機安全試験まで停止）" Click="Merge_Click" IsEnabled="False"/>
        <Button x:Name="StopButton" Content="中断要求" Click="Stop_Click" IsEnabled="False"/>
        <Button x:Name="RecoveryButton" Content="復旧ウィザード" Click="Recovery_Click"/>
        <Button x:Name="PngInspectButton" Content="PNG読み取り診断" Click="InspectPng_Click"/>
        <Button x:Name="PngPreviewButton" Content="PNG無劣化プレビューを作成" Click="PngPreview_Click"/>
        <Button x:Name="PngBatchButton" Content="PNGフォルダ一括プレビュー／再開" Click="PngBatch_Click"/>
        <Button x:Name="PngAuditButton" Content="PNG記録診断・CSV・末尾修復" Click="PngAudit_Click"/>
        <Button x:Name="PngOrphanButton" Content="PNG未参照候補を監査" Click="PngOrphan_Click"/>
        <Button x:Name="JpegBatchButton" Content="JPGフォルダ一括プレビュー／再開" Click="JpegBatch_Click"/>
        <Button x:Name="JpegBatchReportButton" Content="JPG候補の容量レポート／CSV" Click="JpegBatchReport_Click"/>
        <Button x:Name="CombinedReportButton" Content="PNG/JPG統合容量レポート／CSV" Click="CombinedReport_Click"/>
        <Button x:Name="ReplacementReadinessButton" Content="容量回復の事前安全診断" Click="ReplacementReadiness_Click"/>
        <Button x:Name="JpegRepairButton" Content="JPGログ末尾診断・復旧" Click="JpegRepair_Click"/>
        <Button x:Name="JpegPreviewButton" Content="JPG無劣化プレビュー" Click="JpegPreview_Click"/>
        <Button x:Name="JpegInspectButton" Content="JPG読み取り診断" Click="JpegInspect_Click"/>
        <Button x:Name="StoreButton" Content="統合先を開く" Click="Store_Click"/>
      </WrapPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ProgressBar x:Name="JobProgress" Grid.Column="0" Height="11" Minimum="0" Maximum="100" Value="0" Foreground="#57D1BC" Background="#26394B"/>
        <TextBlock x:Name="ProgressText" Grid.Column="1" Text="待機中" Foreground="#ABC1D4" Margin="14,0,0,0" FontSize="12" Width="180" TextAlignment="Right"/>
      </Grid>
      <TextBlock Foreground="#E7BC81" FontSize="12" Margin="0,8,0,0" Text="※ ハードリンク後は別の場所の同名データも同時に変わる場合があります。編集する画像・動画には使わないでください。"/>
    </StackPanel>

    <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="12" Padding="10" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="重複グループ一覧   （Ctrl / Shift キーで複数選択）" Margin="8,5,0,9" Foreground="#D5E6F3" FontSize="13"/>
        <DataGrid x:Name="GroupsGrid" Background="#182434" Foreground="#F1F6FC" RowBackground="#1C2A3A" AlternatingRowBackground="#223246"
                  BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#34465C"
                  ColumnHeaderHeight="32" HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True"
                  AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                  SelectionChanged="SelectionChanged" FontSize="12" RowHeight="29">
          <DataGrid.Columns>
            <DataGridTextColumn Header="代表ファイル" Binding="{Binding RepresentativeDisplay}" Width="3*"/>
            <DataGridTextColumn Header="件数" Binding="{Binding Count}" Width="65"/>
            <DataGridTextColumn Header="1個のサイズ" Binding="{Binding FileSizeText}" Width="125"/>
            <DataGridTextColumn Header="回復見込" Binding="{Binding SavingsText}" Width="120"/>
            <DataGridTextColumn Header="判定" Binding="{Binding Status}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Border Grid.Row="5" Background="{StaticResource Panel}" CornerRadius="12" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="操作ログ・スキップ理由" Foreground="#ABC1D4" FontSize="12" Margin="0,0,0,7"/>
        <TextBox x:Name="LogBox" TextWrapping="Wrap" FontSize="12" Background="#0E1724" Foreground="#D5E6F3" BorderThickness="0" Padding="8" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
