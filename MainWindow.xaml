<Window x:Class="ChappyStorageCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chappy Storage Compressor — 重複ファイルの整理"
        Width="1040" Height="780" MinWidth="830" MinHeight="610"
        Background="#111111" Foreground="#F5F5F5"
        FontFamily="Yu Gothic UI, Segoe UI"
        WindowStartupLocation="CenterScreen"
        ToolTipService.ShowDuration="20000">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="3,0,3,14">
      <Button DockPanel.Dock="Right" Content="⚙ 設定" Click="Settings_Click"
              Background="#292929" BorderBrush="#393939" Padding="12,6"
              ToolTip="普段使わない検索条件や高度な機能を表示します。"/>
      <StackPanel>
        <TextBlock Text="Chappy Storage Compressor" FontWeight="SemiBold" FontSize="18"/>
        <TextBlock Text="ファイルを確認してから、安全に整理するためのツール"
                   Foreground="#AFAFAF" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0"
                Background="Transparent" BorderThickness="0" Foreground="#F5F5F5">
      <TabControl.Resources>
        <Style TargetType="{x:Type TabItem}">
          <Setter Property="Foreground" Value="#A6A6A6"/>
          <Setter Property="Background" Value="#1D1D1D"/>
          <Setter Property="Padding" Value="18,9"/>
          <Setter Property="Margin" Value="0,0,6,8"/>
          <Setter Property="MinWidth" Value="135"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabItem}">
                <Border x:Name="TabBackground" Background="{TemplateBinding Background}"
                        CornerRadius="16" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="TabBackground" Property="Background" Value="#343434"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>

      <TabItem Header="重複整理" ToolTip="全形式の完全一致ファイルを探し、残すファイルと候補を確認します。">
        <Grid Margin="4,8,4,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#191919" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="検索フォルダ" Foreground="#BDBDBD" FontSize="12" Margin="0,0,0,8"/>
              <DockPanel LastChildFill="True">
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="📁 選択"
                        Click="Browse_Click" ToolTip="重複を探したいフォルダを選びます。"/>
                <TextBox x:Name="PathBox" Height="39" Background="#252525" Foreground="#F5F5F5"
                         BorderBrush="#3B3B3B" Padding="10,6" FontSize="14"
                         VerticalContentAlignment="Center" TextChanged="PathChanged"
                         ToolTip="選択したフォルダの下にある通常ファイルを検索。削除はしません。"/>
              </DockPanel>
              <Button x:Name="ScanButton" Content="⌕  重複ファイルを検索"
                      Click="Scan_Click" Background="#303030" BorderBrush="#404040"
                      Height="44" Margin="0,12,0,0" FontSize="14"
                      ToolTip="拡張子を問わず完全一致を検査します。スキャンだけではファイルは変更されません。"/>
            </StackPanel>
          </Border>

          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
              <TextBlock x:Name="GroupCountText" Text="—" FontSize="24" FontWeight="SemiBold"
                         HorizontalAlignment="Center" ToolTip="内容が完全一致したグループ数"/>
              <TextBlock Text="重複グループ" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock x:Name="DuplicateFileCountText" Text="—" FontSize="24" FontWeight="SemiBold"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="重複ファイル" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
              <TextBlock x:Name="SavingsText" Text="—" FontSize="24" FontWeight="SemiBold"
                         HorizontalAlignment="Center" ToolTip="重複を統合できた場合の理論値。実際に空いた容量ではありません。"/>
              <TextBlock Text="削減見込み（未実行）" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <DockPanel Grid.Row="2" Margin="1,0,1,8">
            <Button DockPanel.Dock="Right" x:Name="DetailsButton"
                    Content="選択グループの詳細" Click="Details_Click" IsEnabled="False"
                    ToolTip="選択した重複グループのファイル一覧と画像プレビューを開きます。削除はしません。"/>
            <TextBlock Text="重複グループ" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="（行をダブルクリックして詳細を開く）"
                       Foreground="#AFAFAF" FontSize="11" VerticalAlignment="Center"
                       Margin="8,1,0,0"/>
          </DockPanel>

          <Border Grid.Row="3" Background="#202020" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
            <TextBlock x:Name="ReadOnlyDashboardText" Foreground="#C9C9C9" FontSize="11"
                       TextWrapping="Wrap"
                       Text="未スキャン。削減見込みは予測値であり、実際の空き容量ではありません。"/>
          </Border>

          <Border Grid.Row="4" Background="#191919" CornerRadius="12" Padding="8"
                  Margin="0,0,0,10">
            <DataGrid x:Name="GroupsGrid" Background="#191919" Foreground="#F1F1F1"
                      RowBackground="#202020" AlternatingRowBackground="#262626"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#363636" ColumnHeaderHeight="34"
                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True"
                      AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                      SelectionChanged="SelectionChanged" MouseDoubleClick="GroupDoubleClick"
                      FontSize="12" RowHeight="34"
                      ToolTip="ダブルクリックするとファイルの場所と画像プレビューを表示します。">
              <DataGrid.Columns>
                <DataGridTextColumn Header="代表ファイル" Binding="{Binding RepresentativeDisplay}" Width="3*"/>
                <DataGridTextColumn Header="件数" Binding="{Binding Count}" Width="65"/>
                <DataGridTextColumn Header="1個のサイズ" Binding="{Binding FileSizeText}" Width="115"/>
                <DataGridTextColumn Header="削減見込" Binding="{Binding SavingsText}" Width="115"/>
                <DataGridTextColumn Header="状態（統合基準）" Binding="{Binding Status}" Width="2*"/>
                <DataGridTemplateColumn Header="" Width="44">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="›" Click="GroupDetailRow_Click"
                              ToolTip="この重複グループの全ファイルと画像プレビューを開きます。"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#E6E6E6" Padding="5,1" Margin="0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <Expander x:Name="AdvancedExpander" Grid.Row="5"
                    Header="詳細設定・追加の確認" Foreground="#D5D5D5"
                    ToolTip="重複検索の対象制限や、従来の安全診断機能を表示します。">
            <Border Background="#1C1C1C" CornerRadius="10" Padding="12" Margin="0,7,0,0">
              <StackPanel>
                <CheckBox x:Name="MediaOnlyCheck" IsChecked="False"
                          Content="画像・動画のみに絞る（初期設定は全形式）"
                          Checked="OptionsChanged" Unchecked="OptionsChanged"
                          ToolTip="オフならすべての拡張子を重複検索します。特殊ファイルは安全のため除外されます。"/>
                <CheckBox x:Name="TimeDifferenceCheck" Margin="0,8,0,8"
                          Content="作成日時・更新日時の違いを許容して統合候補を表示"
                          Checked="OptionsChanged" Unchecked="OptionsChanged"
                          ToolTip="日時が違うファイルも完全一致として検索されます。この設定は統合候補の安全判定を変更するため注意。"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                  <TextBlock Text="調査対象：" Foreground="#AFAFAF"/>
                  <TextBlock x:Name="ScannedCountText" Text="—" Margin="0,0,18,0"/>
                  <TextBlock Text="厳格な統合候補：" Foreground="#AFAFAF"/>
                  <TextBlock x:Name="SafeCountText" Text="—"/>
                  <TextBlock Text=" グループ" Foreground="#AFAFAF"/>
                </StackPanel>
                <WrapPanel>
                  <Button x:Name="MediaReportButton" Content="形式別容量レポート・CSV"
                          Click="MediaReport_Click" IsEnabled="False"
                          ToolTip="画像・動画別の重複候補と理論削減量をレポートします。"/>
                  <Button x:Name="DedupePlanButton" Content="統合とUndoの安全計画"
                          Click="DedupePlan_Click" IsEnabled="False"
                          ToolTip="ファイルの変更を行わず、ハードリンク方式のリスクとUndo条件を検査します。"/>
                  <Button x:Name="SelectedMergeReviewButton" Content="選択グループの統合確認"
                          Click="SelectedMergeReview_Click" IsEnabled="False"
                          ToolTip="ハードリンク統合の確認用。本番の統合はまだ許可されていません。"/>
                  <Button x:Name="MergeButton" Content="ハードリンク統合（未解禁）"
                          Click="Merge_Click" IsEnabled="False"
                          ToolTip="複数のパスが同じ実体を共有する方式です。通常の実行は安全ロック中。"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Expander>
        </Grid>
      </TabItem>

      <TabItem Header="画像圧縮" ToolTip="元ファイルを変更せずにPNG/JPEGの無劣化圧縮候補を作ります。">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="5,10,8,8">
            <TextBlock Text="画像圧縮" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,6"/>
            <TextBlock Foreground="#B8B8B8" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="重複整理で指定した検索フォルダを使います。候補は別フォルダに保存され、元画像を置換しません。"/>
            <Border Background="#1E1E1E" CornerRadius="14" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="かんたん操作" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <Button x:Name="UnifiedBatchButton" Content="PNG / JPG の圧縮候補をまとめて作る"
                        Click="UnifiedBatch_Click" Background="#303030"
                        FontSize="14" Padding="15,12"
                        ToolTip="元画像の画素や保護対象のメタデータを維持できる候補だけを別フォルダに作成します。"/>
                <Button x:Name="CombinedReportButton" Content="圧縮候補の容量レポート"
                        Click="CombinedReport_Click"
                        ToolTip="実際の空き容量ではなく、圧縮候補から計算した理論上の削減見込みを確認します。"/>
                <Button x:Name="CopyOnlyPreparationButton" Content="原本の安全なコピー準備"
                        Click="CopyOnlyPreparation_Click"
                        ToolTip="別NTFSドライブに原本の独立バックアップを作ります。原本は変更せず、保存容量は追加で使います。"/>
              </StackPanel>
            </Border>
            <Expander Header="高度な画像操作・診断" Foreground="#D5D5D5">
              <Border Background="#1C1C1C" CornerRadius="10" Padding="12" Margin="0,7,0,0">
                <WrapPanel>
                  <Button x:Name="PngInspectButton" Content="PNG読み取り診断"
                          Click="InspectPng_Click" ToolTip="PNGファイルの構造を検査します。"/>
                  <Button x:Name="PngPreviewButton" Content="PNG単体候補"
                          Click="PngPreview_Click" ToolTip="PNGを1枚選んで候補を生成します。"/>
                  <Button x:Name="PngBatchButton" Content="PNG一括候補・再開"
                          Click="PngBatch_Click" ToolTip="PNGの候補生成を複数件まとめて行います。"/>
                  <Button x:Name="PngAuditButton" Content="PNG処理記録の診断"
                          Click="PngAudit_Click" ToolTip="PNG候補のログと異常な記録を検査します。"/>
                  <Button x:Name="PngOrphanButton" Content="PNG未参照候補の調査"
                          Click="PngOrphan_Click" ToolTip="処理途中に残った候補を読み取り専用で調べます。"/>
                  <Button x:Name="JpegInspectButton" Content="JPG読み取り診断"
                          Click="JpegInspect_Click" ToolTip="JPEGの構造と保護対象メタデータを調べます。"/>
                  <Button x:Name="JpegPreviewButton" Content="JPG単体候補"
                          Click="JpegPreview_Click" ToolTip="無劣化JPEG変換の候補を生成します。"/>
                  <Button x:Name="JpegBatchButton" Content="JPG一括候補・再開"
                          Click="JpegBatch_Click" ToolTip="JPEG候補生成をまとめて行います。"/>
                  <Button x:Name="JpegBatchReportButton" Content="JPG候補容量レポート"
                          Click="JpegBatchReport_Click" ToolTip="JPG候補の見込み削減量を集計します。"/>
                  <Button x:Name="JpegRepairButton" Content="JPGログの診断"
                          Click="JpegRepair_Click" ToolTip="中断されたJPEG候補処理の記録を検査します。"/>
                  <Button x:Name="ReplacementReadinessButton" Content="適用前の安全性診断"
                          Click="ReplacementReadiness_Click" ToolTip="候補とバックアップ容量を厳密に調べます。原本置換は行いません。"/>
                </WrapPanel>
              </Border>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="履歴・復元" ToolTip="復旧証拠、完了履歴、要手動確認の問題を調査します。">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="5,10,8,8">
            <TextBlock Text="履歴・復元" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,6"/>
            <TextBlock Foreground="#B8B8B8" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="中断や不一致を調べる画面です。不明な状態のファイルや記録は自動で削除しません。"/>
            <Border Background="#1E1E1E" CornerRadius="14" Padding="16">
              <StackPanel>
                <Button x:Name="RecoveryButton" Content="復旧ウィザードを開く"
                        Click="Recovery_Click" Background="#303030" FontSize="14"
                        ToolTip="復旧記録と要手動確認の理由を調べます。"/>
                <Button x:Name="CleanupHistoryButton" Content="重複整理の保留記録を確認"
                        Click="CleanupHistory_Click" Background="#303030"
                        ToolTip="保留先と元の保存場所、復帰やごみ箱処理の記録を読み取り専用で表示します。削除・復元操作は行いません。"/>
                <Button x:Name="CompletedLedgerButton" Content="保存済み統合履歴を確認"
                        Click="CompletedLedger_Click"
                        ToolTip="過去の統合とUndoの記録を読み取り専用で調べます。"/>
                <Button x:Name="StoreButton" Content="統合記録フォルダを開く"
                        Click="Store_Click"
                        ToolTip="統合の履歴や退避関連ファイルの保存場所を開きます。"/>
              </StackPanel>
            </Border>
            <TextBlock Text="本番の重複統合・独立Undo・画像原本置換は安全ロック中です。"
                       Foreground="#D6B078" TextWrapping="Wrap" Margin="4,16,0,0" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Margin="4,10,4,8">
      <DockPanel LastChildFill="True">
        <Button x:Name="StopButton" Content="中断" DockPanel.Dock="Right" Click="Stop_Click"
                IsEnabled="False" Margin="8,0,0,0" Padding="10,5"
                ToolTip="進行中の処理へ中断を要求します。処理済みのファイルの履歴は保持します。"/>
        <TextBlock x:Name="ProgressText" Text="待機中" DockPanel.Dock="Right"
                   Foreground="#BDBDBD" VerticalAlignment="Center"
                   TextAlignment="Right" Width="250" FontSize="12"/>
        <ProgressBar x:Name="JobProgress" Height="9" Minimum="0" Maximum="100" Value="0"
                     Foreground="#67C4AF" Background="#292929" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="検索と画像候補作成は原本を変更しません。重複削除と本番の置換・統合は未解禁です。"
                 Foreground="#D0B27B" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
    </StackPanel>
    <Expander Grid.Row="3" Header="操作ログ・スキップ理由" Foreground="#BABABA"
              Margin="4,0,4,0" ToolTip="診断が必要なときだけ展開できます。">
      <Border Background="#1B1B1B" CornerRadius="10" Padding="9" Margin="0,6,0,0">
        <TextBox x:Name="LogBox" Height="105" TextWrapping="Wrap"
                 FontSize="11" Background="#1B1B1B" Foreground="#D6D6D6"
                 BorderThickness="0" IsReadOnly="True" Padding="5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
      </Border>
    </Expander>
  </Grid>
</Window>
