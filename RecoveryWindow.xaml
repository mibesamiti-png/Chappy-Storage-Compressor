<Window x:Class="ChappyStorageCompressor.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chappy Recovery Wizard R1.3 — 復旧状態を検査" Width="1050" Height="720"
        MinWidth="800" MinHeight="550" WindowStartupLocation="CenterOwner"
        Background="#0E1724" Foreground="#F1F6FC" FontFamily="Yu Gothic UI, Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="175"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="RECOVERY / SAFETY FIRST" FontSize="12" FontWeight="Bold" Foreground="#57D1BC"/>
      <TextBlock Text="復旧ウィザード" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,4"/>
      <TextBlock Text="まず現在のファイル実体とSHA-256を再検証します。曖昧な状態のファイルは変更しません。"
                 Foreground="#B1C5D7" FontSize="13" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#193044" CornerRadius="9" Padding="12" Margin="0,0,0,13">
      <StackPanel>
        <TextBlock x:Name="SummaryText" Text="状態を読み込んでいます…" Foreground="#C7E0EF" FontSize="13" TextWrapping="Wrap"/>
        <TextBlock x:Name="HistorySummaryText" Text="統合済み・Undo履歴：対象フォルダの読み取り専用検証待ち"
                   Foreground="#70DBC7" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="CollisionSummaryText" Text="同名ファイル調査：対象フォルダの読み取り専用検証待ち"
                   Foreground="#E1C581" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TabControl x:Name="RecoveryTabs" Grid.Row="2" Margin="0,0,0,12"
                Background="#142538" Foreground="#F1F6FC"
                SelectionChanged="RecoveryTabChanged">
      <TabItem Header="未解決の操作記録">
        <DataGrid x:Name="RecoveryGrid" Background="#182434" Foreground="#F1F6FC"
              RowBackground="#1C2A3A" AlternatingRowBackground="#223246" BorderThickness="0"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#35475A"
              HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False"
              IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
              SelectionChanged="RecoverySelectionChanged" RowHeight="29" FontSize="12"
              Margin="0,0,0,12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="対象ファイル" Binding="{Binding DisplayName}" Width="2*"/>
        <DataGridTextColumn Header="検査結果" Binding="{Binding ActionText}" Width="3*"/>
        <DataGridTextColumn Header="元パス" Binding="{Binding OriginalPath}" Width="4*"/>
      </DataGrid.Columns>
    </DataGrid>
      </TabItem>
      <TabItem Header="統合・Undo証拠の横断チェック（読み取り専用）">
        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="HistorySelectionChanged"
                  Background="#182434" Foreground="#F1F6FC"
                  RowBackground="#1C2A3A" AlternatingRowBackground="#223246"
                  BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#35475A" HeadersVisibility="Column"
                  RowHeight="29" FontSize="12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="証拠の種類" Binding="{Binding Source}" Width="2*"/>
            <DataGridTextColumn Header="判定" Binding="{Binding AttentionText}" Width="*"/>
            <DataGridTextColumn Header="現在の状態" Binding="{Binding State}" Width="2*"/>
            <DataGridTextColumn Header="対象名・記録ID" Binding="{Binding Target}" Width="3*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="同名ファイル調査（読み取り専用）">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="3,0,3,8">
            <TextBlock Text="調査優先度：" VerticalAlignment="Center" Foreground="#D8E8F4" Margin="0,0,6,0"/>
            <ComboBox x:Name="CollisionPriorityFilter" Width="148" SelectedIndex="0"
                      SelectionChanged="CollisionPriorityFilterChanged">
              <ComboBoxItem Content="すべて" Tag="ALL"/>
              <ComboBoxItem Content="P0 最優先" Tag="P0"/>
              <ComboBoxItem Content="P1 未完了" Tag="P1"/>
              <ComboBoxItem Content="P2 元未照合" Tag="P2"/>
              <ComboBoxItem Content="U 未判定" Tag="U"/>
            </ComboBox>
            <TextBlock x:Name="CollisionPriorityCounts" VerticalAlignment="Center"
                       Margin="12,0,0,0" Text="調査結果を確認中…"
                       Foreground="#E1C581" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        <DataGrid x:Name="CollisionGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="CollisionSelectionChanged"
                  Background="#182434" Foreground="#F1F6FC"
                  RowBackground="#1C2A3A" AlternatingRowBackground="#223246"
                  BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#35475A" HeadersVisibility="Column"
                  RowHeight="29" FontSize="12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="優先度" Binding="{Binding PriorityLabel}" Width="*"/>
            <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="*"/>
            <DataGridTextColumn Header="判定" Binding="{Binding AttentionText}" Width="*"/>
            <DataGridTextColumn Header="状態" Binding="{Binding State}" Width="2*"/>
            <DataGridTextColumn Header="元の相対パス" Binding="{Binding OriginalRelativePath}" Width="3*"/>
            <DataGridTextColumn Header="保存先・証拠" Binding="{Binding DisplayTarget}" Width="3*"/>
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#172739" CornerRadius="9" Padding="12" Margin="0,0,0,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="DetailText" Text="ファイルを選ぶと、検証内容と復旧手順が表示されます。"
                   Foreground="#D8E8F4" TextWrapping="Wrap" FontSize="12"/>
      </ScrollViewer>
    </Border>
    <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
      <Button x:Name="RefreshButton" Content="状態を再検査" Click="Refresh_Click" Margin="4" MinWidth="125"/>
      <Button x:Name="UndoReviewButton" Content="履歴から独立Undo対象を再特定（未実行）"
              Click="UndoReview_Click" Margin="4" MinWidth="280" IsEnabled="False"/>
      <Button x:Name="UndoExecuteButton" Content="生成データの独立Undo（検証用・通常は無効）"
              Click="UndoExecute_Click" Margin="4" MinWidth="260" IsEnabled="False"/>
      <Button x:Name="UndoCancelButton" Content="生成Undoを中断（記録保全）"
              Click="UndoCancel_Click" Margin="4" MinWidth="180" IsEnabled="False"/>
      <Button x:Name="ApplyButton" Content="選択した1件を安全に復旧" Click="Apply_Click"
              Margin="4" MinWidth="200" IsEnabled="False" Background="#2B7B70" BorderBrush="#3E9E8F"/>
      <Button Content="閉じる" Click="Close_Click" Margin="4" MinWidth="90"/>
    </WrapPanel>
  </Grid>
</Window>
