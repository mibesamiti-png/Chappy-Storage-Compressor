<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);CHAPPY_TESTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The UI runner references the real WPF app; do not include it in the
         standalone Core-only synthetic assembly. -->
    <Compile Remove="UiInteractionSmoke.cs" />
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
