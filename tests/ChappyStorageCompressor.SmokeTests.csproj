<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);CHAPPY_TESTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The UI runner references the real WPF app; do not include it in the
         standalone Core-only synthetic assembly. -->
    <Compile Remove="UiInteractionSmoke.cs" />
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <!-- Compile the EXACT production WPF review/history source under
         CHAPPY_TESTING in this non-shipped synthetic smoke executable. -->
    <Compile Include="..\DuplicateCleanupReviewWindow.cs" Link="Wpf\DuplicateCleanupReviewWindow.cs" />
    <Compile Include="..\DuplicateCleanupHistoryWindow.cs" Link="Wpf\DuplicateCleanupHistoryWindow.cs" />
  </ItemGroup>
</Project>
